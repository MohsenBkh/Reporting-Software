{
  "domain": "loading",
  "description": "طبقه‌بندی وضعیت بارگذاری فیدر بر اساس نسبت پیک بار به معیار (ظرفیت)",
  "rules": [
    {
      "id": "L-CRITICAL",
      "name": "بارگذاری بحرانی",
      "condition": "has_capacity and f_loading_pct > loading_heavy_pct",
      "text_id": "T-LOAD-CLASS-CRITICAL",
      "priority": 50,
      "severity": "error"
    },
    {
      "id": "L-HEAVY",
      "name": "فیدر پربار",
      "condition": "has_capacity and f_loading_pct > loading_semi_pct",
      "text_id": "T-LOAD-CLASS-HEAVY",
      "priority": 40,
      "severity": "warning"
    },
    {
      "id": "L-SEMI",
      "name": "نسبتاً پربار",
      "condition": "has_capacity and f_loading_pct > loading_normal_pct",
      "text_id": "T-LOAD-CLASS-SEMI",
      "priority": 30,
      "severity": "warning"
    },
    {
      "id": "L-NORMAL",
      "name": "عادی و نسبتاً کم‌بار",
      "condition": "has_capacity and f_loading_pct > loading_light_pct",
      "text_id": "T-LOAD-CLASS-NORMAL",
      "priority": 20,
      "severity": "normal"
    },
    {
      "id": "L-LIGHT",
      "name": "کم‌بار",
      "condition": "has_capacity",
      "text_id": "T-LOAD-CLASS-LIGHT",
      "priority": 10,
      "severity": "normal"
    },
    {
      "id": "L-UNKNOWN",
      "name": "معیار نامشخص",
      "condition": "not has_capacity",
      "text_id": "T-LOAD-CLASS-UNKNOWN",
      "priority": 5,
      "severity": "review"
    }
  ]
}