+def _added_load_mw(project: Project, settings: AppSettings) -> Optional[float]:
+    """بار اضافه‌شدهٔ جدید متقاضی (MW) — مبنا: تقاضای تحلیل، سپس افزایش قدرت.
+
+    هیچ مقداری ساخته نمی‌شود؛ اگر هیچ داده‌ای نباشد None برمی‌گردد.
