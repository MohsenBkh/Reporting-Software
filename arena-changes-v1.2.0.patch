+    text = "\n".join(x.text for s in sections for x in s.paragraphs())
+    assert "{" not in text and "}" not in text          # هیچ متغیر پرنشده‌ای نماند
+    caps = [b.caption for s in sections for b in s.blocks if isinstance(b, TableSpec)]
